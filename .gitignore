# Each of these is its own independent git repo (junctioned in from
# F:\workspace\Projects) - never tracked here, this repo only owns the
# top-level docs/launchers tying them together.
/felt-core/
/felt-animation/
/felt-tray/
/felt-dashboard/
/felt-character-assets/
/felt-t2a-studio/
/AnimToVrmaConverter/
/felt-vision/

# Convenience junctions into felt-character-assets, so the animation
# library and the base model are visible right at E:\Felt instead of
# buried under felt-character-assets\felt-godot-overlay\... - the real
# content lives (and is tracked) there, these are just shortcuts.
/Animations/
/Model/

# Machine-local (which Godot.exe to use for exports) - never portable/shared
/godot_path.txt

# Scratch output (overlay {"screenshot"} captures, debug renders) - never tracked
/scratch/

# Third-party binaries downloaded for experiments (llama.cpp builds etc.)
/tools/llamacpp/

# WP-19 sound candidates awaiting Mario's pick (keepers under Sounds/<kind>/ are tracked)
/Sounds/candidates/

# Voice A/B listening rounds (test renders, not keepers)
/Sounds/ab-test/

# Review app batches (tools/outfits/review): generated VRMs derived from paid assets - never tracked
/review/

# Outfit tooling caches
/tools/outfits/.preview_shaders/
/tools/outfits/__pycache__/

# git sees the junctions as files, so the /dir/ patterns above miss them
/Animations
/Model
__pycache__/
*.lnk

# bought / third-party models, animations, textures and voice clips - never commit (stripped from history 2026-10-24)
VRoid/
AnimBackup/
Assets/
Sounds/
scratch/
*.vrm
*.vrma
*.glb
*.fbx
*.wav
*.pmx
*.psd

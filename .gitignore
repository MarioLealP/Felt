# Each of these is its own independent git repo (junctioned in from
# F:\workspace\Projects) - never tracked here, this repo only owns the
# top-level docs/launchers tying them together.
/felt-core/
/felt-animation/
/felt-tray/
/felt-dashboard/
/felt-character-assets/
/felt-t2a-studio/
/AnimToVrmaConverter/
/felt-vision/

# Convenience junctions into felt-character-assets, so the animation
# library and the base model are visible right at E:\Felt instead of
# buried under felt-character-assets\felt-godot-overlay\... - the real
# content lives (and is tracked) there, these are just shortcuts.
/Animations/
/Model/

# Machine-local (which Godot.exe to use for exports) - never portable/shared
/godot_path.txt
